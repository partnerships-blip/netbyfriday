# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.

# Supabase (Project Settings → API). `supabase start` prints the local values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One AI provider, server-side only. Powers the AI Advisor and drafts.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=
# AI_HOURLY_LIMIT=40
# ANTHROPIC_BASE_URL=   # optional override; the e2e suite points this at a local stub

# Optional: OpenAI-compatible provider instead (AI_PROVIDER=openai-compatible)
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=

# Feature flags (comma separated). Off in V1: insights,opportunities,audience,attachments,prototypeImport,whiteLabel
NEXT_PUBLIC_NBF_FLAGS=

# Founder alerts (docs/FOUNDER_ALERTS.md): email to our own inbox when someone requests a beta invite. Server-side only.
# SMTP_USER=hello@netbyfriday.com
# SMTP_PASS=            # Google Workspace app password
# FOUNDER_ALERT_TO=hello@netbyfriday.com
